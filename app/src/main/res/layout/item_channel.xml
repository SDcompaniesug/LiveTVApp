<?xml version="1.0" encoding="utf-8"?>
<android.widget.LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/channelRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_channel_item"
    android:clickable="true"
    android:focusable="true">

    <androidx.cardview.widget.CardView
        android:layout_width="88dp"
        android:layout_height="58dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#15181E">
        <android.widget.ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:padding="3dp"
            android:src="@drawable/default_image"
            android:contentDescription="Channel image" />
    </androidx.cardview.widget.CardView>

    <android.widget.LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">
        <android.widget.TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rwenzori TV"
            android:textColor="#F2F2F2"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <android.widget.TextView
            android:id="@+id/channelCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="General"
            android:textColor="#969BA5"
            android:textSize="12sp"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </android.widget.LinearLayout>

    <android.widget.ImageView
        android:id="@+id/favoriteIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="3dp"
        android:src="@drawable/ic_heart_outline"
        android:layout_marginEnd="8dp"
        android:contentDescription="Favorite"
        android:clickable="true"
        android:focusable="true" />

    <android.widget.ImageView
        android:id="@+id/channelChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:padding="2dp"
        android:src="@drawable/ic_chevron_settings"
        app:tint="#858B96"
        android:contentDescription="Open channel" />
</android.widget.LinearLayout>